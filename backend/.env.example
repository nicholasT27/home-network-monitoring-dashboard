# Copy to backend/.env for local use. On a cloud host, set the same names as environment variables instead.
# Do not commit the real .env file.

DB_HOST=127.0.0.1
DB_NAME=home_network_monitor
DB_USER=root
DB_PASS=

SUBNET=192.168.1.0/24
# live = this server scans its own network (backend runs at home)
# agent = a home agent (agent.php) scans and sends results (use this on a cloud server)
# demo = simulated devices
SCAN_MODE=live

DASHBOARD_PASSWORD=changeme
AUTH_SECRET=replace-with-a-long-random-string
# Extra browser origins allowed to call the API, e.g. your deployed dashboard URL (comma separated)
ALLOWED_ORIGINS=

# Sender account for alert emails (Gmail: enable 2-Step Verification, then create an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your.project.account@gmail.com
SMTP_PASS=your-16-character-app-password

# Home agent (cloud deployment): the same AGENT_KEY must be set on the cloud API and on the home computer
AGENT_KEY=replace-with-a-long-random-string
# Only needed on the home computer running agent.php:
AGENT_API_URL=https://your-api.example.com/index.php
AGENT_INTERVAL_S=120
